# Postgres DB Information
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_DATABASE=burmese_jewellery

# HTTP Server Port
HTTP_PROTOCOL=http
HTTP_DOMAIN=localhost
HTTP_PORT=8077

# Others
ALLOW_ORIGINS="http://localhost:8081;http://localhost:8060;http://localhost:8030"
DEBUG=true
USE_TLS=false
FILE_PATH=./file

# debug, release, test
GIN_MODE=debug
